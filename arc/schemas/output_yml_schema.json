{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ReactionMechanismGenerator/ARC/schemas/output_yml_schema.json",
  "title": "ARC output.yml",
  "description": "Mechanical definition of the consolidated output.yml contract ARC writes to <project_directory>/output/output.yml. Prose reference: docs/output_yml_schema.md. A key listed in 'required' is always emitted; a key whose type includes 'null' may be emitted as null; a key that is neither required nor null-typed is omitted entirely under the conditions stated in the reference. 'unevaluatedProperties'/'additionalProperties' are false wherever ARC controls the key set, so a field added to arc/output.py without a matching schema change fails validation.",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "arc_version",
    "arc_git_commit",
    "arkane_git_commit",
    "datetime_started",
    "datetime_completed",
    "composite_method",
    "opt_level",
    "freq_level",
    "sp_level",
    "arkane_level_of_theory",
    "freq_scale_factor",
    "freq_scale_factor_source",
    "bac_type",
    "atom_energy_corrections",
    "bond_additivity_corrections",
    "species",
    "transition_states",
    "reactions"
  ],
  "properties": {
    "schema_version": {
      "description": "Output contract version. Emitted from arc.tckdb_evidence.OUTPUT_SCHEMA_VERSION, shared with the evidence sidecar's output_schema_version.",
      "const": "1.1"
    },
    "project": {
      "type": "string"
    },
    "arc_version": {
      "type": "string"
    },
    "arc_git_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "arkane_git_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "datetime_started": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$"
    },
    "datetime_completed": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$"
    },
    "tckdb_evidence": {
      "description": "Omitted (key absent, never null) when the evidence sidecar could not be built or written.",
      "$ref": "#/$defs/tckdb_evidence_descriptor"
    },
    "composite_method": {
      "$ref": "#/$defs/nullable_level_dict"
    },
    "opt_level": {
      "$ref": "#/$defs/nullable_level_dict"
    },
    "freq_level": {
      "$ref": "#/$defs/nullable_level_dict"
    },
    "sp_level": {
      "$ref": "#/$defs/nullable_level_dict"
    },
    "neb_level": {
      "description": "Omitted (key absent, never null) unless the orca_neb TS adapter was configured with a level.",
      "$ref": "#/$defs/level_dict"
    },
    "arkane_level_of_theory": {
      "$ref": "#/$defs/nullable_level_dict"
    },
    "freq_scale_factor": {
      "type": [
        "number",
        "null"
      ]
    },
    "freq_scale_factor_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "bac_type": {
      "enum": [
        "p",
        "m",
        null
      ]
    },
    "atom_energy_corrections": {
      "description": "Arkane's reference atomic electronic energies in hartree, keyed by element symbol.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "number"
      }
    },
    "bond_additivity_corrections": {
      "description": "The Arkane BAC parameter table for the run's level of theory, in the model's native shape: a flat per-bond map in kcal/mol for Petersson, the nested per-element table for Melius.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/petersson_bac_table"
        },
        {
          "$ref": "#/$defs/melius_bac_table"
        }
      ]
    },
    "species": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/species_record"
      }
    },
    "transition_states": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ts_record"
      }
    },
    "reactions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reaction"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "bac_type": {
            "const": "p"
          }
        },
        "required": [
          "bac_type"
        ]
      },
      "then": {
        "properties": {
          "bond_additivity_corrections": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/petersson_bac_table"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "bac_type": {
            "const": "m"
          }
        },
        "required": [
          "bac_type"
        ]
      },
      "then": {
        "properties": {
          "bond_additivity_corrections": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/melius_bac_table"
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "petersson_bac_table": {
      "description": "The Petersson BAC parameter table: per-bond parameters in kcal/mol, keyed by bond descriptor.",
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "melius_bac_table": {
      "description": "The Melius BAC parameter table in its native nested shape, as arkane.encorr.data.mbac stores it: three per-element parameter maps plus one scalar molecular correction.",
      "type": "object",
      "required": [
        "atom_corr",
        "bond_corr_length",
        "bond_corr_neighbor",
        "mol_corr"
      ],
      "properties": {
        "atom_corr": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "bond_corr_length": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "bond_corr_neighbor": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "mol_corr": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "tckdb_evidence_descriptor": {
      "type": "object",
      "required": [
        "path",
        "schema_name",
        "schema_version",
        "document_id"
      ],
      "properties": {
        "path": {
          "const": "tckdb_evidence.json"
        },
        "schema_name": {
          "const": "arc-tckdb-evidence"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "document_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      },
      "additionalProperties": false
    },
    "level_dict": {
      "description": "Level.as_dict() with the 'repr' and 'compatible_ess' keys removed. Only the level's non-None attributes appear, so the key set varies between runs.",
      "type": "object",
      "properties": {
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "auxiliary_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "dispersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "cabs": {
          "type": [
            "string",
            "null"
          ]
        },
        "method_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "software": {
          "type": [
            "string",
            "null"
          ]
        },
        "software_version": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "solvation_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "solvent": {
          "type": [
            "string",
            "null"
          ]
        },
        "solvation_scheme_level": {
          "description": "Emitted by _level_to_dict as a nested level dict of the same shape.",
          "$ref": "#/$defs/nullable_level_dict"
        },
        "args": {
          "description": "Free-form ESS keyword blocks; the key set is the user's, not ARC's.",
          "type": [
            "object",
            "string",
            "null"
          ]
        },
        "year": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "nullable_level_dict": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/level_dict"
        }
      ]
    },
    "ess_versions": {
      "description": "ESS version strings keyed by job type, parsed from each available log.",
      "type": "object",
      "properties": {
        "opt": {
          "type": "string"
        },
        "freq": {
          "type": "string"
        },
        "sp": {
          "type": "string"
        },
        "neb": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "constraint": {
      "description": "One held-fixed coordinate parsed from an ESS input deck or log. index_base is the source convention: 1 for Gaussian, 0 for Orca.",
      "type": "object",
      "required": [
        "coordinate_type",
        "atom_indices",
        "index_base",
        "target_value"
      ],
      "properties": {
        "coordinate_type": {
          "enum": [
            "cartesian",
            "distance",
            "angle",
            "dihedral"
          ]
        },
        "atom_indices": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 1
        },
        "index_base": {
          "enum": [
            0,
            1
          ]
        },
        "target_value": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "constraint_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "spin_diagnostic": {
      "description": "S**2 spin contamination of the single-point wavefunction. null for restricted/closed-shell logs and for non-converged species.",
      "type": "object",
      "required": [
        "s_squared"
      ],
      "properties": {
        "s_squared": {
          "type": "number"
        },
        "s_squared_expected": {
          "type": "number"
        },
        "s_squared_annihilated": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "optimization_stage_settings": {
      "type": "object",
      "required": [
        "optimization_stage"
      ],
      "properties": {
        "optimization_stage": {
          "enum": [
            "coarse",
            "fine"
          ]
        }
      },
      "additionalProperties": false
    },
    "correction_component": {
      "description": "One native per-atom or per-bond term of an applied correction, as produced by arc/scripts/get_species_corrections.py.",
      "type": "object",
      "required": [
        "component_kind",
        "key",
        "multiplicity",
        "parameter_value",
        "parameter_unit",
        "contribution_value"
      ],
      "properties": {
        "component_kind": {
          "enum": [
            "atom",
            "bond"
          ]
        },
        "key": {
          "type": "string"
        },
        "multiplicity": {
          "type": "integer"
        },
        "parameter_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "parameter_unit": {
          "description": "Pinned to hartree for an atom component and kcal_mol for a bond component by the 'allOf' branches below. Pinning it is what makes a silent kJ/mol-for-kcal/mol substitution a validation failure rather than a factor-of-4.184 error in a consumer.",
          "type": "string"
        },
        "contribution_value": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "component_kind": {
                "const": "atom"
              }
            },
            "required": [
              "component_kind"
            ]
          },
          "then": {
            "properties": {
              "parameter_unit": {
                "const": "hartree"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "component_kind": {
                "const": "bond"
              }
            },
            "required": [
              "component_kind"
            ]
          },
          "then": {
            "properties": {
              "parameter_unit": {
                "const": "kcal_mol"
              }
            }
          }
        }
      ]
    },
    "energy_correction": {
      "description": "One applied correction model with its total, native decomposition, and the parameter table ARC used.",
      "type": "object",
      "required": [
        "correction_type",
        "model",
        "level_of_theory",
        "matched_arkane_key",
        "total",
        "components"
      ],
      "properties": {
        "correction_type": {
          "enum": [
            "atom_energy",
            "bond_additivity"
          ]
        },
        "model": {
          "description": "The legal model names are enumerated once, per correction_type, in the 'allOf' branches below.",
          "type": "string"
        },
        "level_of_theory": {
          "$ref": "#/$defs/nullable_level_dict"
        },
        "matched_arkane_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "total": {
          "type": "object",
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "description": "Pinned to hartree for an atom-energy correction and kcal_mol for a bond-additivity one by the 'allOf' branches below.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/correction_component"
          }
        },
        "reference_atom_energies": {
          "description": "Atom-energy corrections only. Omitted (key absent, never null) when the run has no such table.",
          "type": "object",
          "required": [
            "unit",
            "applied_as",
            "values"
          ],
          "properties": {
            "unit": {
              "const": "hartree"
            },
            "applied_as": {
              "const": "subtracted"
            },
            "values": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            }
          },
          "additionalProperties": false
        },
        "parameter_table": {
          "description": "Petersson bond-additivity corrections only, and only when the BAC key matched the AEC key. Omitted (key absent, never null) otherwise.",
          "type": "object",
          "required": [
            "unit",
            "values"
          ],
          "properties": {
            "unit": {
              "const": "kcal_mol"
            },
            "values": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "correction_type": {
                "const": "atom_energy"
              }
            },
            "required": [
              "correction_type"
            ]
          },
          "then": {
            "properties": {
              "model": {
                "const": "arkane_atom_energy"
              },
              "total": {
                "properties": {
                  "unit": {
                    "const": "hartree"
                  }
                }
              }
            },
            "not": {
              "required": [
                "parameter_table"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "correction_type": {
                "const": "bond_additivity"
              }
            },
            "required": [
              "correction_type"
            ]
          },
          "then": {
            "properties": {
              "model": {
                "enum": [
                  "petersson",
                  "melius"
                ]
              },
              "total": {
                "properties": {
                  "unit": {
                    "const": "kcal_mol"
                  }
                }
              }
            },
            "not": {
              "required": [
                "reference_atom_energies"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "model": {
                "const": "melius"
              }
            },
            "required": [
              "model"
            ]
          },
          "then": {
            "not": {
              "required": [
                "parameter_table"
              ]
            }
          }
        }
      ]
    },
    "scan_sample": {
      "type": "object",
      "required": [
        "source_index",
        "angle_degrees",
        "relative_energy_kj_mol"
      ],
      "properties": {
        "source_index": {
          "type": "integer",
          "minimum": 0
        },
        "angle_degrees": {
          "type": "number"
        },
        "relative_energy_kj_mol": {
          "type": "number"
        },
        "electronic_energy_hartree": {
          "description": "Omitted (key absent, never null) when the parser gave no aligned absolute-energy list.",
          "type": "number"
        },
        "geometry_xyz": {
          "description": "Omitted (key absent, never null) when the per-point geometries were unavailable or did not align 1:1 with the energies.",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "scan_coordinate": {
      "type": "object",
      "required": [
        "coordinate_type",
        "atom_indices",
        "index_base",
        "unit",
        "sample_count"
      ],
      "properties": {
        "coordinate_type": {
          "const": "dihedral"
        },
        "atom_indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true
        },
        "index_base": {
          "const": 1
        },
        "unit": {
          "const": "degree"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "symmetry_number": {
          "description": "Omitted (key absent, never null) unless ARC determined an integer symmetry of at least 1.",
          "type": "integer",
          "minimum": 1
        },
        "requested_step_size": {
          "description": "Omitted (key absent, never null) for ESS whose logs do not echo the requested grid.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "requested_start": {
          "description": "Omitted (key absent, never null) without a requested_step_size or a computable dihedral.",
          "type": "number"
        },
        "requested_end": {
          "description": "Omitted (key absent, never null) under the same condition as requested_start.",
          "type": "number"
        }
      },
      "additionalProperties": false,
      "dependentRequired": {
        "requested_start": [
          "requested_end",
          "requested_step_size"
        ],
        "requested_end": [
          "requested_start",
          "requested_step_size"
        ]
      }
    },
    "scan_result": {
      "type": "object",
      "required": [
        "dimension",
        "relaxed",
        "coordinate",
        "samples"
      ],
      "properties": {
        "dimension": {
          "const": 1
        },
        "relaxed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "zero_energy_reference_hartree": {
          "description": "Omitted (key absent, never null) when the parser reports none.",
          "type": "number"
        },
        "coordinate": {
          "$ref": "#/$defs/scan_coordinate"
        },
        "samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scan_sample"
          }
        }
      },
      "additionalProperties": false
    },
    "rotor_scan": {
      "type": "object",
      "required": [
        "key",
        "source_log",
        "result"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^scan_rotor_.+$"
        },
        "source_log": {
          "type": [
            "string",
            "null"
          ]
        },
        "constraints": {
          "description": "Held-fixed coordinates excluding the scanned coordinate. Omitted (key absent, never null) when none were found.",
          "allOf": [
            {
              "$ref": "#/$defs/constraint_list"
            }
          ],
          "minItems": 1
        },
        "result": {
          "$ref": "#/$defs/scan_result"
        }
      },
      "additionalProperties": false
    },
    "one_or_multi_dimensional_indices": {
      "description": "An atom-index list taken straight from rotors_dict: a flat list of integers for a 1D rotor, or a list of such lists for an ND directed rotor, which the scheduler also marks successful.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 1
          },
          "minItems": 1
        }
      ]
    },
    "torsion": {
      "type": "object",
      "required": [
        "symmetry_number",
        "treatment",
        "dimension",
        "atom_indices",
        "pivot_atoms",
        "barrier_kj_mol",
        "source_scan_key"
      ],
      "properties": {
        "symmetry_number": {
          "type": [
            "integer",
            "null"
          ]
        },
        "treatment": {
          "enum": [
            "hindered_rotor",
            "free_rotor"
          ]
        },
        "dimension": {
          "type": "integer",
          "minimum": 1,
          "description": "Rotor dimensionality. 1 for an ordinary 1D rotor; higher for an ND directed rotor, whose atom_indices and pivot_atoms are then lists of lists and whose barrier_kj_mol is null."
        },
        "atom_indices": {
          "description": "The rotor's 1-indexed scanned dihedral: a flat 4-atom list for a 1D rotor, one such list per dimension for an ND directed rotor.",
          "$ref": "#/$defs/one_or_multi_dimensional_indices"
        },
        "pivot_atoms": {
          "description": "The rotor's 1-indexed rotation axis, dimensioned exactly as atom_indices.",
          "$ref": "#/$defs/one_or_multi_dimensional_indices"
        },
        "barrier_kj_mol": {
          "type": [
            "number",
            "null"
          ]
        },
        "source_scan_key": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^scan_rotor_.+$"
        }
      },
      "additionalProperties": false
    },
    "rejected_torsion": {
      "description": "A rotor ARC evaluated and genuinely rejected (rotors_dict entry whose 'success' is False), carried so a consumer can tell 'no rotors' from 'rotors found and rejected, for these reasons' rather than losing the rejected rotor entirely. Pending or never-attempted rotors ('success' is None) are not carried here -- ARC has not decided their fate yet. This rotor never contributes a rotor_scans record -- rejected rotors are excluded from rotor_scans entirely -- so source_log records the raw scan-log path directly rather than referencing a rotor_scans key.",
      "type": "object",
      "required": [
        "rotor_index",
        "invalidation_reason",
        "atom_indices",
        "pivot_atoms",
        "dimension"
      ],
      "properties": {
        "rotor_index": {
          "type": "integer",
          "description": "The rotor's key in rotors_dict, i.e. its identifying index among the species' rotors (not an atom index)."
        },
        "invalidation_reason": {
          "type": "string",
          "description": "ARC's recorded reason(s) the rotor was rejected, verbatim. An empty string means ARC recorded no specific reason -- not that one was fabricated here. This is accumulated with '+=' across troubleshooting rounds, so it may contain more than one concatenated reason rather than a single discrete one."
        },
        "atom_indices": {
          "description": "The rotor's 1-indexed scanned dihedral, when recorded: a flat 4-atom list for a 1D rotor, one such list per dimension for an ND directed rotor. Null when rotors_dict has no 'scan' entry for this rotor.",
          "$ref": "#/$defs/one_or_multi_dimensional_indices"
        },
        "pivot_atoms": {
          "description": "The rotor's 1-indexed rotation axis, when recorded, dimensioned exactly as atom_indices. Null when rotors_dict has no 'pivots' entry for this rotor.",
          "$ref": "#/$defs/one_or_multi_dimensional_indices"
        },
        "dimension": {
          "type": "integer",
          "minimum": 1,
          "description": "Rotor dimensionality, exactly as the successful torsion shape's 'dimension'. 1 for an ordinary 1D rotor; higher for an ND directed rotor, whose atom_indices and pivot_atoms are then lists of lists."
        },
        "source_log": {
          "type": "string",
          "description": "The rejected rotor's scan log path, relative to the project directory (bare os.path.relpath, no containment check -- a log outside the project directory yields a '../..'-prefixed path; same behavior as rotor_scans[].source_log, not changed here), when one is found on disk at write time. Omitted entirely (never null) when rotors_dict records no on-disk scan for this rotor. IMPORTANT: this field's absence does NOT mean the rotor was never a torsion -- it only means no scan log was found on disk when output.yml was written. A genuinely-scanned rotor can still lack this field: a restart-restored rejected rotor's stale relative scan_path is only repaired for rotors where success is truthy, so it routinely fails the on-disk check; a failed directed scan has its scan_path deliberately blanked to '' while still recording a real invalidation_reason; and a TS reaction-zone pivot exclusion sets success=False for policy reasons, typically before any scan is attempted. ARC's rotors_dict does not currently distinguish these rejection stages from a genuine 'not a torsion' determination -- invalidation_reason is the only (free-text, imperfect) signal available. Deliberately not a rotor_scans[].key reference: rejected rotors never produce a rotor_scans record (rotor_scans only admits success=True rotors), and a rejected rotor's log may itself be truncated or self-inconsistent, so this records where the evidence is rather than a parsed result."
        }
      },
      "additionalProperties": false
    },
